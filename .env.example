# Chép file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore — KHÔNG BAO GIỜ commit token lên git.
#
#   cp .env.example .env
#   nano .env
#   ./.venv/bin/python cli.py check-token     # kiểm tra token có dùng được không

# ID của Fanpage. Lấy ở Trang > Giới thiệu, hoặc gọi GET /me?access_token=... với Page token.
FB_PAGE_ID=

# Page Access Token (KHÔNG phải User Token).
#
# Page token rút ra từ một USER TOKEN DÀI HẠN thì KHÔNG CÓ HẠN — đó là thứ cần dùng.
# Rút từ user token ngắn hạn của Graph API Explorer thì chết sau 1-2 giờ.
# Thứ tự bắt buộc: fb-longlive (đổi user token sang 60 ngày) TRƯỚC, rồi mới fb-info.
# Làm ngược lại là công cốc. Xem docs/lay-token-facebook.md.
FB_PAGE_ACCESS_TOKEN=

# Phiên bản Graph API. Đổi nếu Meta ngừng hỗ trợ phiên bản này.
FB_API_VERSION=v21.0

# App ID và App Secret — CHỈ cần khi đổi token dài hạn (cli.py fb-longlive).
# Lấy ở developers.facebook.com > App của bạn > Cài đặt ứng dụng > Cơ bản.
FB_APP_ID=
FB_APP_SECRET=

# ---- Màn hình quản trị ----
# Trang này có nút đăng bài lên Fanpage và đang chạy trên subdomain công khai,
# nên BẮT BUỘC phải có mật khẩu. Không đặt -> app trả 503 cho mọi trang.
# Sinh mật khẩu: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
AUTOFB_USER=admin
AUTOFB_PASSWORD=

# ---- Threads (tuỳ chọn) ----
# Đăng lại mỗi bài Fanpage sang Threads. Bỏ trống thì phần này tự tắt, không báo lỗi.
#
# Token Threads RIÊNG, không suy ra được từ Page token Facebook — phải cấp qua
# graph.threads.net. Xem docs/lay-token-threads.md.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
